# 运行环境
NODE_ENV=development

# 服务端口
PORT=3000
MCP_PORT=3001

# 系统数据库路径
SYSTEM_DB_PATH=./data/system.db

# Web UI 配置
WEB_UI_ENABLED=true
WEB_UI_PORT=3000

# MCP 传输方式：sse 或 stdio
MCP_TRANSPORT=sse

# 加密密钥 (32 位十六进制字符串)
# 生成方式：openssl rand -hex 32
ENCRYPTION_KEY=

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 审计日志配置
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=30

# 查询限制
MAX_QUERY_ROWS=10000
DEFAULT_QUERY_LIMIT=100
QUERY_TIMEOUT_MS=30000

# 安全配置
API_KEY=
YOUR_SECRET
ALLOW_DDL=false
REQUIRE_DELETE_CONFIRMATION=true

# 连接池配置
POOL_MIN=2
POOL_MAX=10
POOL_IDLE_TIMEOUT=30000
